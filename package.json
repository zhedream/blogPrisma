{
  "name": "blog-prisma",
  "version": "2.0.0",
  "description": "GraphQL API for the blog",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": ">=20.19 <25"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "security:check": "node scripts/check-dependencies.mjs",
    "security:audit": "npm audit --audit-level=high",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:pull": "prisma db pull",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate deploy",
    "db:bootstrap:test": "node scripts/bootstrap-test-database.mjs"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "17.4.2",
    "graphql": "16.14.2",
    "graphql-yoga": "5.22.0",
    "tsx": "4.23.13"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "prisma": "7.10.0",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mariadb": "3.4.7",
    "mysql2": "3.24.3"
  }
}
